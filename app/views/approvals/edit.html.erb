<%= form_with(model: @approval, url: paid_leave_approval_path(@approval), local: true) do |form| %>

  <h1 class="text-center">有給取得申請編集</h1>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">

        <%= render "approvals/form", approval: @approval, form: form %>

        <% end %>

        <div>
          <%= link_to "有給休暇申請画面に戻る", request_path(@paid_leave.id), class: "text-decoration-none" %>
        </div>

      </div>
    </div>
  </div>