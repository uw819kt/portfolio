<% if @approval.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <ul>
        <% @approval.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">

        <div>
          <%= form.label :request_date %><br>
          <%= form.date_field :request_date, required: true, class: "form-select" %>
        </div>

        <div>
          <%= form.label :acquisition_date %><br>
          <%= form.date_field :acquisition_date, required: true, class: "form-select" %>
        </div>

        <div>
          <%= form.label :paid_remarks %><br>
          <%= form.text_area :paid_remarks, placeholder: "特記事項あれば記入 例）介護休暇", class: "form-control" %>
        </div>

        <div>
          <%= form.label :paid_applicable, class: "form-check-label" %></br>
          <%= form.check_box :paid_applicable, { class: "form-check-input" }, "true", "false" %>
          <small>※通常の有給休暇として処理する場合はチェックを入れてください</small>
        </div>

        <div>
          <%= form.submit class: "btn btn-outline-primary mt-4 mb-3 w-100" %>
        </div>

      </div>
    </div>
  </div>