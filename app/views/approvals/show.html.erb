<h1><%= Date.today.year %>年&nbsp;有給休暇取得状況詳細（承認済）</h1>

<%= render 'shared', approval: @approval %>

<table class="table table-striped">
  <thead>
    <tr class="table-primary">
      <th>No</th>
      <th><%= "届出年月日" %></th>
      <th><%= "取得日" %></th>
      <th><%= "残日数" %></th>
      <th><%= "本人印" %></th>
      <th><%= "承認印" %></th>
      <th><%= "備考" %></th>
      <th><%= "通常有給適用" %></th>
      <th><%= "有給申請確認" %></th>
    </tr>
  </thead>
    
  <tbody>
    <% @approval.each_with_index do |approval, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= approval.request_date %></td>
        <td><%= approval.acquisition_date %></td>
        <td id="target"><%= @achievements %></td>
        <td></td> <!-- 空のセル -->
        <td></td> <!-- 空のセル -->
        <td><%= approval.paid_remarks %></td>
        <td><%= approval&.paid_applicable ? '適用' : '未適用' %></td>
        <td><%= approval&.paid_confirm ? '承認済' : '承認未' %></td>
      </tr>      
    <% end %>
  </tbody>
</table>
  
<div>  
  <%= link_to "戻る", root_path, class: "text-decoration-none" %>
</div>