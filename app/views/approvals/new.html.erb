<%= form_with(model: @approval, url: paid_leave_approvals_path(paid_leave_id: @paid_leave.id), local: true) do |form| %>

  <h1 class="text-center">有給取得申請（承認）</h1>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">

        <%= render "approvals/form", approval: @approval, form: form %>

<% end %>

      <div>
        <%= link_to "有給休暇取得状況詳細に戻る", request_path(@paid_leave), class: "text-decoration-none" %>
      </div>

      </div>
    </div>
  </div>