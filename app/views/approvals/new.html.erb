<%= form_with(model: @approval, url: paid_leave_approvals_path(paid_leave_id: @paid_leave.id), local: true) do |form| %>

  <% if @approval.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <ul>
        <% @approval.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<h1>有給取得申請（承認）</h1>

  <div>
    <%= form.label :request_date %><br>
    <%= form.date_field :request_date, required: true %>
  </div>

  <div>
    <%= form.label :acquisition_date %><br>
    <%= form.date_field :acquisition_date, required: true %>
  </div>

  <div>
    <%= form.label :paid_remarks %><br>
    <%= form.text_area :paid_remarks, placeholder: "特記事項あれば記入 例）介護休暇" %>
  </div>

  <div>
    <%= form.label :paid_applicable %></br>
    <%= form.check_box :paid_applicable, {checked: true}, true, false  %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

  <div>
    <%= link_to "有給休暇取得状況詳細に戻る", request_path(@paid_leave) %>
  </div>