<div class="container">
  <div class="row mb-2 justify-content-end">
    <div class="col-2 fw-bold text-start  border-bottom border-dark">部署</div>
    <div class="col-2 text-start border-bottom border-dark"><%= @user.department_i18n %></div>
  </div>

  <div class="row mb-2 justify-content-end">
    <div class="col-2 fw-bold text-start  border-bottom border-dark">氏名</div>
    <div class="col-2 text-start border-bottom border-dark"><%= @user.name %></div>
  </div>
</div>

<% if can? :manage, Approval %>
  <%= link_to "PDFを出力", paid_leave_pdf_paid_leave_index_path(format: "pdf"), class: 'btn btn-outline-primary mt-2 mb-2' %>
<% end %>

<table class="table table-bordered mb-0">
  <tbody>
      <tr>
        <td colspan="2" class="table-primary"><%= "基準日" %></td>
        <td colspan="4"><%= l @paid_leave.base_date, format: :long %></td>
      </tr>
      <tr>
        <td colspan="2" class="table-primary"><%= "有効期間" %></td>
        <td colspan="4"><%= "#{l @paid_leave.base_date, format: :long}～#{l @paid_leave.base_date.next_year - 1, format: :long}" %></td>
      </tr>
      <tr>
        <td ><%= "合計日数" %></td>
        <td><%= @grant.granted_piece %></td>

        <td><%= "前年度繰越分" %></td>
        <td>-</td>

        <td><%= "今年度付与分" %></td>
        <td><%= @grant.granted_piece %></td>
      </tr>
  <tbody>
</table>