<h1 class="text-center">酒気帯び確認記録表（個人）</h1>

<h6 class="d-flex justify-content-end mb-3">興和電気株式会社</h6>

<div class="container">
  <div class="row mb-2 justify-content-end">
    <div class="col-2 fw-bold text-start  border-bottom border-dark">部署</div>
    <div class="col-2 text-start border-bottom border-dark"><%= @user.department %></div>
  </div>

  <div class="row mb-2 justify-content-end">
    <div class="col-2 fw-bold text-start  border-bottom border-dark">氏名</div>
    <div class="col-2 text-start border-bottom border-dark"><%= @user.name %></div>
  </div>
</div>

<h5><%=  Date.today %></h5>

<table class="table table-striped m-0">
  <tbody>
    <tr class="table-primary">
      <td colspan="7"><%= "運転前" %></td>
      <td></td>
      <td colspan="7"><%= "運転後" %></td>
      <td colspan="1"><%= "確認欄" %></td>
      <td></td>
    </tr>

    <tr>
      <td><%= "確認年月日" %></td>
      <td><%= "確認方法" %></td>
      <td><%= "検知器使用" %></td>
      <td><%= "測定結果（mg/l）" %></td>
      <td><%= "体調等（状態）" %></td>
      <td><%= "指示事項/その他" %></td>
      <td><%= "確認者" %></td>
      <td></td>
      <td><%= "確認年月日" %></td>
      <td><%= "確認方法" %></td>
      <td><%= "検知器使用" %></td>
      <td><%= "測定結果（mg/l）" %></td>
      <td><%= "体調等（状態）" %></td>
      <td><%= "指示事項/その他" %></td>
      <td><%= "確認者" %></td>
      <td><%= "安全運転管理者" %></td>
    </tr>

    <% start_date = Time.zone.today.beginning_of_month %>
    <% end_date = Time.zone.today.end_of_month %>

    <% (start_date..end_date).each do |day| %>
      <% be_log = @drive_be_log.find { |log| log.check_time.to_date == day } %>
      <% af_log = @drive_af_log.find { |log| log.check_time.to_date == day } %>
    
      <tr>
        <%# 運転前ログがあるか？ %>
        <% if be_log %>
          <td><%= be_log.check_time %></td>
          <td><%= be_log.confirmation %></td>
          <td><%= be_log.detector_used ? '有' : '無' %></td>
          <td><%= be_log.result %></td>
          <td><%= be_log.condition %></td>
          <td><%= be_log.log_remarks %></td>
          <td></td><!-- 空欄 -->
          <td><%= link_to "編集（前）", edit_drive_be_log_path(be_log.id), class: "btn btn-outline-primary btn-sm" %></td>
        <% else %>
          <td colspan="7"></td>
          <td></td>
        <% end %>
    
        <%# 運転後ログがあるか？ %>
        <% if af_log %>
          <td><%= af_log.check_time %></td>
          <td><%= af_log.confirmation %></td>
          <td><%= af_log.detector_used ? '有' : '無' %></td>
          <td><%= af_log.result %></td>
          <td><%= af_log.condition %></td>
          <td><%= af_log.log_remarks %></td>
          <td></td><!-- 空欄 -->
          <td></td><!-- 空欄 -->
          <td><%= link_to "編集（後）", edit_drive_af_log_path(af_log.id), class: "btn btn-outline-primary btn-sm" %></td>
        <% else %>
          <td colspan="7"></td>
          <td></td>
          <td></td>
        <% end %>
      </tr>
    <% end %>     
  </tbody>
</table>

<%= link_to "一覧に戻る", alcohol_logs_path, class: "text-decoration-none" %>
