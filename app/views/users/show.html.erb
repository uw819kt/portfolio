<h1 class="text-center">社員情報（詳細）</h1>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card mb-4">
        <div class="card-header text-center">
          <h5 class="card-title">基本情報</h5>
        </div>
        <div class="card-body">
          <p><strong>氏名:</strong> <%= @user.name %></p>
          <p><strong>部署:</strong> <%= @user.department_i18n %></p>
          <p><strong>メール:</strong> <%= @user.email %></p>
          <p><strong>管理者権限:</strong> <%= @user.is_admin ? "あり" : "なし" %></p>


          <%= link_to "基本情報を編集", edit_user_path(@user), class: "btn btn-outline-primary mt-3 w-100" %>
        </div>
      </div>


      <div class="card mb-4">
        <div class="card-header text-center">
          <h5 class="card-title mb-0">車両関連情報</h5>
        </div>
        <div class="card-body">
          <%= form_with(model: [@user, @car], local: true) do |form| %>
            
            <%= render "cars/form", car: @car, form: form %>

            <%= form.submit "車両関連情報を更新", class: "btn btn-primary w-100" %>
          <% end %>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header text-center">
          <h5 class="card-title mb-0">有給休暇基礎情報</h5>
        </div>
        <div class="card-body">
          <% if @grant.present? %>
            <p><strong>入社日:</strong> <%= l(@paid_leave.joining_date, format: :long) if @paid_leave&.joining_date.present? %></p>
            <p><strong>基準日:</strong> <%= l(@paid_leave.base_date, format: :long) if @paid_leave&.base_date.present? %></p>
            <p><strong>勤務形態:</strong> <%= @paid_leave&.classification_i18n %></p>
            <p><strong>パート区分:</strong> <%= @paid_leave&.part_time ? 'パート' : 'フルタイム' %></p>
            <small class="text-muted">※パート勤務の人のみ</small><br>

            <%= link_to "有給休暇基礎情報を編集", edit_paid_leave_path, class: "btn btn-outline-primary mt-3 w-100" %>
          <% else %>
            <p class="text-muted">有給休暇の基礎情報がまだありません。</p>
            <%= link_to "有給休暇基礎情報を新規登録", new_user_paid_leave_path(@user), class: "btn btn-outline-primary mt-3 w-100" %>
          <% end %>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header text-center">
          <h5 class="card-title mb-0">有給休暇付与情報</h5>
        </div>
        <div class="card-body">
          <% if @grant.present? %>
            <p><strong>付与日数:</strong> <%= @grant.granted_piece %></p>
            <p><strong>付与日:</strong> <%= l @grant.granted_day, format: :long %></p>

            <%= link_to "有給休暇付与情報を編集", edit_user_grant_path(@user, @grant), class: "btn btn-outline-primary mt-3 w-100" %>
          <% else %>
            <p class="text-muted">有給休暇の付与情報がまだありません。</p>
            <%= link_to "有給休暇付与情報を新規登録", new_user_grant_path(@user, @grant), class: "btn btn-outline-primary mt-3 w-100" %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>     
