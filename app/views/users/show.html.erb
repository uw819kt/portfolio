<h1>社員情報（詳細）</h1>

<h3>基本情報</h3>
<%= "社員氏名: #{@user.name}" %><br>
<%= "部署: #{@user.department}" %><br>
<%= "メールアドレス: #{@user.email}" %><br>

<div>
  <%= link_to "基本情報を編集", edit_user_path %>
</div>

<h3>車両関連情報</h3>
<%= form_with(model: @user.car, url: car_path, local: true, method: :patch) do |form| %>
  <div class="field">
    <%= form.label :private_car, "私用車の車両番号:" %>
    <%= form.text_field :private_car, placeholder: "任意" %>
  </div>

  <div class="field">
    <%= form.label :company_car, "社用車の車両番号:" %>
    <%= form.text_field :company_car, placeholder: "任意" %>
  </div>

  <div class="actions">
    <%= form.submit "更新" %>
  </div>
<% end %>

<h3>有給休暇関連情報</h3>
<%= "入社日: #{@paid_leave&.joining_date}" %><br>
<%= "基準日: #{@paid_leave&.base_date}" %><br>
<%= "勤務形態: #{@paid_leave&.classification}" %><br>
<%= "パート区分: #{@paid_leave&.part_time ? 'パート' : 'フルタイム'}" %>
<small>※パート勤務の人のみ</small>

<div>
  <%= link_to "有給休暇関連情報を編集", edit_paid_leafe_path %>
</div>


