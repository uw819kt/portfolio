<%= form_with(model: @user, remote: false) do |form| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <ul>
        <% @user.errors.each do |error| %>
        <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %></br>
    <%= form.text_field :name, required: true, placeholder: "必須", class: "form-control" %>
  </div>

  <div>
    <%= form.label :department %></br>
    <%= form.select :department, User.departments.keys.map {|k| [I18n.t("enums.user.department.#{k}"), k]}, { prompt: "部署を選択" }, class: "form-select" %>
  </div>

  <div>
    <%= form.label :email %></br>
    <%= form.email_field :email, required: true, placeholder: "必須", class: "form-control" %>
  </div>

  <div>
  <%= form.label :is_admin, class: "form-check-label" %></br>
  <%= form.check_box :is_admin, { class: "form-check-input" }, "true", "false" %>
  <small>※管理者権限を付与する場合はチェックを入れてください</small>
</div>

  <%= form.submit class: "btn btn-outline-primary mt-4 mb-3 w-100" %>
<% end %>