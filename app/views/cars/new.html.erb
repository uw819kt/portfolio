<h3 class="text-center">社員情報新規登録2/4</h3>
<h1 class="text-center">車両関連情報</h1>

<p>車両番号を登録しない場合は空欄のまま登録を押してください。</p>

<% if @car.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <ul>
        <% @car.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <%= form_with(model: @car, url: user_cars_path, local: true) do |form| %>
        <%= form.hidden_field :user_id, value: @user.id %>

        <%= render "cars/form", car: @car, form: form %>

        <div class="actions">
          <%= form.submit class: "btn btn-outline-primary mt-4 mb-3 w-100" %>
        </div>
      <% end %>

    </div>
  </div>
</div>