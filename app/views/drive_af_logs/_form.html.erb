<div>
      <%= form.label :user_id %></br>
      <%= form.collection_select :user_id, User.all, :id, :name, { prompt: "氏名を選択" }, { required: true, class: "form-select" } %>
    </div>

    <div>
      <%= form.label :car_id %></br>
      <%= form.collection_select :car_id, Car.all, :id, :car_number, { prompt: "車両を選択" }, { required: true, class: "form-select" } %>
    </div>

    <div>
      <%= form.label :confirmation %></br>
      <%= form.select :confirmation, DriveAfLog.confirmations.keys.map { |k| [I18n.t("enums.drive_af_log.confirmation.#{k}"), k] }, 
      {}, 
      class: "form-control" %>
    </div>

    <div>
      <%= form.label :detector_used %></br>
      <%= form.check_box :detector_used, {checked: true}, true, false  %>
    </div>

    <div>
      <%= form.label :result %></br>
      <%= form.text_field :result, class: "form-control", placeholder: "例）0.00" %>
    </div>

    <div>
      <%= form.label :condition %></br>
      <%= form.select :condition, DriveAfLog.conditions.keys.map { |k| [I18n.t("enums.drive_af_log.condition.#{k}"), k] }, 
      {}, 
      class: "form-control" %>
    </div>

    <div>
      <%= form.label :log_remarks %></br>
      <%= form.text_area :log_remarks, class: "form-control", placeholder: "特記事項あれば記入" %>
    </div>

    <%= form.submit class: "btn btn-outline-primary mt-4" %>