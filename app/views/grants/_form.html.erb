<% if @grant.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <ul>
      <% @grant.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<p>計算結果：<%= @granted_days %>日</p>
  <div>
    <%= form.label :granted_piece %></br>
    <%= form.number_field :granted_piece, min: 0, max: 99, required: true, class: "form-control", value: @granted_days %>
  </div>

  <div>
    <%= form.label :granted_day %></br>
    <%= form.date_field :granted_day, required: true, class: "form-select" %>
  </div>

  <%= form.submit class: "btn btn-outline-primary mt-4 mb-4 w-100" %>