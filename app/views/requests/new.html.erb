<h1 class="text-center">有給取得申請入力フォーム</h1>
  <%= form_with(model: @request, url: requests_path, local: true) do |form| %>

    <% if @request.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <ul>
          <% @request.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">

        <div>
          <%= form.label :request_date %><br>
          <%= form.date_field :request_date, class: "form-select" %>
        </div>

        <div>
          <%= form.label :acquisition_date %><br>
          <%= form.date_field :acquisition_date, class: "form-select" %>
        </div>

        <div>
          <%= form.label :paid_remarks %><br>
          <%= form.text_area :paid_remarks, placeholder: "特記事項あれば記入 例）介護休暇", class: "form-control" %>
        </div>

        <div>
          <%= form.submit class: "btn btn-outline-primary mt-4 mb-4 w-100" %>
        </div>
      <% end %>

      <div>
        <%= link_to "有給休暇一覧画面に戻る", root_path, class: "text-decoration-none" %>
      </div>

      </div>
    </div>
  </div>
