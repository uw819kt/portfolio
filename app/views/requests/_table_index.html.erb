<table class="table table-striped">
  <thead>
    <tr class="table-primary">
      <th>No</th>
      <th><%= "氏名" %></th>
      <th><%= "届出年月日" %></th>
      <th><%= "取得日" %></th>
      <th><%= "残日数" %></th>
      <th><%= "本人印" %></th>
      <th><%= "承認印" %></th>
      <th><%= "備考" %></th>
      <th><%= "通常有給適用" %></th>
      <th><%= "有給申請確認" %></th>
      <th></th> <!-- 空のセル -->
    </tr>
  </thead>
    
  <tbody>
    <% @request.each_with_index do |request, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <th><%= request.user.name %></th>
        <td><%= l request.request_date, format: :long %></td>
        <td><%= l request.acquisition_date, format: :long %></td>
        <td id="target">
          <% @remaining_leave_days.each do |leave_info| %>
            <%= leave_info[:remaining_days] %>
          <% end %>
        </td>
        <td></td> <!-- 空のセル -->
        <td></td> <!-- 空のセル -->
        <td><%= request.paid_remarks %></td>
        <td><%= request.approval&.paid_applicable ? '適用' : '未適用' %></td>
        <td><%= request.approval&.paid_confirm ? '承認済' : '承認未' %></td>
        <td><%= link_to "承認する", new_paid_leave_approval_path(request.paid_leave_id, request_id: request.id), class: "btn btn-outline-primary btn-sm mb-1" %></td>
      </tr>      
    <% end %>
  </tbody>
</table>