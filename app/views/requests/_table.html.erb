<table class="table table-striped">
  <thead>
    <tr class="table-primary">
      <th>No</th>
      <th><%= "届出年月日" %></th>
      <th><%= "取得日" %></th>
      <th><%= "残日数" %></th>
      <th><%= "本人印" %></th>
      <th><%= "承認印" %></th>
      <th><%= "備考" %></th>
      <th><%= "通常有給適用" %></th>
      <th><%= "有給申請確認" %></th>
    </tr>
  </thead>
    
  <tbody>
    <% @request.each_with_index do |request, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= request.request_date %></td>
        <td><%= request.acquisition_date %></td>
        <td id="target"><%= "合計日数" %></td>
        <td></td> <!-- 空のセル -->
        <td></td> <!-- 空のセル -->
        <td><%= request.paid_remarks %></td>
        <td><%= request.approval&.paid_applicable ? '適用' : '未適用' %></td>
        <td><%= request.approval&.paid_confirm ? '承認済' : '承認未' %></td>
        <td><%= link_to (request.approval.present? ? "編集する" : "承認する"), request.approval_link %></td><!-- 管理者のみ表示 -->
      </tr>      
    <% end %>
  </tbody>
</table>