<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cucumber" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div><%# 社員向け %>
      <%= link_to "酒気帯び記録表入力(運転前)", new_drive_be_log_path %>
      <%= link_to "酒気帯び記録表入力(運転後)", new_drive_af_log_path %>
      <%= link_to "酒気帯び記録表入力状況一覧", alcohol_logs_path %>
      <%= link_to "有給休暇取得申請", new_request_path %>
      <%= link_to "有給休暇取得状況一覧", root_path %>
    </div>
    <div><%# 管理者向け %>
    </div>

    <div><%# 管理者向け %>
      <%= link_to "社員情報一覧", users_path %>
      <%= link_to "社員情報新規登録", new_user_path %>
      <%= link_to "酒気帯び記録表入力(運転前)", new_drive_be_log_path %>
      <%= link_to "酒気帯び記録表入力(運転後)", new_drive_af_log_path %>
      <%= link_to "酒気帯び記録表入力状況一覧", alcohol_logs_path %>
      <%= link_to "有給休暇取得申請", new_request_path %>
      <%= link_to "有給休暇取得状況一覧", root_path %>
      <%= link_to "ログアウト", destroy_admin_session_path, method: :delete, data: { turbo_method: :delete } %>
    </div>

    <% flash.each do |key, message| %>
      <div class="alert alert-<%= key == 'notice' ? 'success' : 'alert' %>">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
