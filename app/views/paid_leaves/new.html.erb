<h3 class="text-center">社員情報新規登録3/4</h3>

<h1 class="text-center">有給休暇情報登録フォーム</h1>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
  
      <%= form_with(model: @paid_leave, url: user_paid_leaves_path(@user), local: true) do |form| %>
        <%= form.hidden_field :user_id, value: @user.id %>

        <%= render "paid_leaves/errors", paid_leave: @paid_leave %>

        <%= render "paid_leaves/form", paid_leave: @paid_leave, form: form %>

      <% end %>

      <div>
        <%= link_to "一覧に戻る", users_path, class: "text-decoration-none" %>
      </div>

    </div>
  </div>
</div>