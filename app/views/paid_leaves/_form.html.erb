  <div>
    <%= form.label :joining_date %></br>
    <%= form.date_field :joining_date, required: true, class: "form-select" %>
  </div>

  <div>
    <%= form.label :base_date %></br>
    <%= form.date_field :base_date, required: true, class: "form-select" %>
  </div>

  <div>
    <%= form.label :part_time %></br>
    <%= form.check_box :part_time, {checked: false}, true, false  %>
    <small>※パートタイムの場合はチェックを入れてください</small></br>
  </div>

  <div>
    <%= form.label :classification %></br>
    <%= form.select :classification, PaidLeave.classifications.keys.map {|k| [I18n.t("enums.paid_leave.classification.#{k}"), k]}, { prompt: "勤務形態を選択" }, class: "form-select" %>
  </div>

  <%= form.submit class: "btn btn-outline-primary mt-4" %>