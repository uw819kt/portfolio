<h1 class="text-center">有給休暇取得一覧画面</h1>

<h5><%= Date.today %></h5>

<!-- 未承認の有給の数を管理者のみ表示 -->
<% if @unapproved_request_count.positive? %>
  <p class="alert alert-warning">
    未確認の有給申請が <%= link_to @unapproved_request_count, requests_path %> 件あります。
  </p>
<% end %>

<table class="table table-striped mt-3">
  <thead>
    <tr class="table-primary">
      <th>No</th>
      <!-- <th><%= "社員番号" %></th> -->
      <th><%= "名前" %></th>
      <th><%= "入社日" %></th>
      <th><%= "基準日" %></th>
      <th><%= "年休保有日数(基準日時点)" %></th>
      <th><%= "予定日数" %></th>
      <th><%= "取得数（実績）" %></th>
        <% (4..12).each do |month| %>
          <th><%= month %>月</th>
        <% end %>
        <% (1..3).each do |month| %>
          <th><%= month %>月</th>
        <% end %>
      <th></th>
    </tr>
  </thead>

  <tbody>
  <% @paid_leaves.each_with_index do |paid_leave, index| %>  
    <tr>
      <td><%= index + 1 %></td>
      <td><%= paid_leave.user.name %></td>
      <td><%= paid_leave.joining_date %></td>
      <td><%= paid_leave.base_date %></td>
      <td><%= paid_leave.grant&.granted_piece || "-" %></td>
      <td><%= paid_leave.grant&.granted_piece || "-" %></td>
      <td><%= paid_leave.paid_achievements %></td>
      <% (4..12).each do |month| %>
        <td><%= paid_leave.paid_totalling(month) || "-" %></td>
      <% end %>
      
      <% (1..3).each do |month| %>
        <td><%= paid_leave.paid_totalling(month) || "-" %></td>
      <% end %>

      <td>
        <%= link_to "承認済", paid_leave_approval_path(paid_leave, 0), class: "btn btn-outline-primary btn-sm mb-1" %>
        <%= link_to "申請中", request_path(paid_leave), class: "btn btn-outline-primary btn-sm mb-1" %>
      </td>
    </tr>
  <% end %>
  </tbody> 
</table>


